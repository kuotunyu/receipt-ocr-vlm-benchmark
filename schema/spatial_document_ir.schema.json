{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/spatial_document_ir.schema.json",
  "title": "Spatial Document IR",
  "type": "object",
  "required": [
    "schema_version",
    "document",
    "parser",
    "pages",
    "parsing_timestamp"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "document": {
      "type": "object",
      "required": ["document_id", "checksum_sha256"],
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "checksum_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_uri": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "parser": {
      "type": "object",
      "required": ["name", "version", "config"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "config": {"type": "object"}
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "page_number",
          "width",
          "height",
          "coordinate_space",
          "elements"
        ],
        "properties": {
          "page_number": {"type": "integer", "minimum": 1},
          "width": {"type": "number", "exclusiveMinimum": 0},
          "height": {"type": "number", "exclusiveMinimum": 0},
          "coordinate_space": {
            "enum": ["pdf_points", "pixels", "normalized"]
          },
          "screenshot_ref": {"type": ["string", "null"]},
          "elements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "element_id",
                "page_number",
                "element_type",
                "text",
                "markdown",
                "reading_order",
                "parent_section_path",
                "metadata"
              ],
              "properties": {
                "element_id": {"type": "string"},
                "page_number": {"type": "integer", "minimum": 1},
                "element_type": {
                  "enum": [
                    "heading",
                    "paragraph",
                    "table",
                    "figure",
                    "caption",
                    "footnote",
                    "list"
                  ]
                },
                "text": {"type": "string"},
                "markdown": {"type": "string"},
                "bbox": {
                  "anyOf": [
                    {"type": "null"},
                    {
                      "type": "object",
                      "required": ["x0", "y0", "x1", "y1", "coordinate_space"],
                      "properties": {
                        "x0": {"type": "number"},
                        "y0": {"type": "number"},
                        "x1": {"type": "number"},
                        "y1": {"type": "number"},
                        "coordinate_space": {
                          "enum": ["pdf_points", "pixels", "normalized"]
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                },
                "reading_order": {"type": "integer", "minimum": 0},
                "parent_section_path": {
                  "type": "array",
                  "items": {"type": "string"}
                },
                "confidence": {
                  "type": ["number", "null"],
                  "minimum": 0,
                  "maximum": 1
                },
                "source_image_ref": {"type": ["string", "null"]},
                "metadata": {"type": "object"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "parsing_timestamp": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
